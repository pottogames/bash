# Copy to `.env.local` and fill in from your Supabase project:
# Dashboard -> Settings -> API
#
# Both values are safe in a browser bundle. The anon key grants nothing on its
# own — row level security decides every row a request can see, which is why
# `supabase/tests/10_rls.test.sql` exists and runs in CI.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
